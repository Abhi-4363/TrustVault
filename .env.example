# ==============================================================================
# TrustVault - Root Environment Configuration Template
# ==============================================================================
# IMPORTANT NOTICE:
# This file is an example template for local development configuration.
# DO NOT store real credentials, sensitive passwords, production secrets, or
# active API tokens in this file or any .env file tracked by Git.
#
# To configure your local environment:
# 1. Copy this file or the respective sub-package .env.example files:
#    - For backend: copy backend/.env.example to backend/.env
#    - For frontend: copy frontend/.env.example to frontend/.env
# 2. Update the values with your local development parameters.
# ==============================================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (Reserved for future stages - not required for Stage 1)
MONGODB_URI=mongodb://localhost:27017/trustvault_dev

# Storage Configuration (Reserved for future stages - private local or cloud storage)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads/private

# Logging Level
LOG_LEVEL=info
