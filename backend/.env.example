# ==============================================================================
# TrustVault Backend - Environment Variables Template
# ==============================================================================
# NOTICE: This is an example template. Do NOT store real credentials in this file.
# Copy this file to '.env' for local development:
#   cp .env.example .env
# ==============================================================================

# Network Port for Express Server
PORT=5000

# Application Environment (development, test, production)
NODE_ENV=development

# Allowed Frontend Origin for CORS Policies
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example: mongodb+srv://<db_user>:<db_password>@cluster.mongodb.net/trustvault_dev?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/trustvault_dev

# JWT Authentication Secret & Token Expiration
JWT_SECRET=trustvault_dev_secret_change_in_production_min32chars
JWT_EXPIRES_IN=24h

# Transactional Email Configuration
# Provider selection: 'brevo' | 'resend' | 'smtp' (Leave empty to auto-detect based on available keys)
EMAIL_PROVIDER=brevo

# Sender email address
# IMPORTANT: For Brevo, this address MUST be verified under Senders & IP in your Brevo dashboard.
EMAIL_FROM=konagallaabhiram@gmail.com
APP_BASE_URL=http://localhost:5173

# Option A: Brevo HTTPS REST API (Port 443 - Recommended for Render, 300 free emails/day)
# Get your API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# Option B: Resend HTTPS REST API (Port 443 - 3,000 free emails/month)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=

# Option C: Gmail SMTP (Note: Render blocks outbound SMTP ports 587/465 on free/starter tiers)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=trustvaultOf@gmail.com
SMTP_PASS=replace_with_google_app_password



