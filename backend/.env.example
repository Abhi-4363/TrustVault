# ==============================================================================
# TrustVault Backend - Environment Variables Template
# ==============================================================================
# NOTICE: This is an example template. Do NOT store real credentials in this file.
# Copy this file to '.env' for local development:
#   cp .env.example .env
# ==============================================================================

# Network Port for Express Server
PORT=5000

# Application Environment (development, test, production)
NODE_ENV=development

# Allowed Frontend Origin for CORS Policies
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Reserved for Stage 2+; non-blocking in Stage 1)
MONGODB_URI=mongodb://localhost:27017/trustvault_dev
